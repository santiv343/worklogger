{
  "name": "@santiv343/worklogger",
  "version": "0.0.0",
  "description": "Local MCP server for Jira worklogs, issue updates, and Bitbucket pull requests, with previews and configurable permissions.",
  "type": "module",
  "bin": {
    "worklogger": "index.mjs"
  },
  "files": [
    "index.mjs",
    "arguments.mjs",
    "platform.mjs",
    "bin/linux-x64/worklogger-mcp",
    "bin/windows-x64/worklogger-mcp.exe",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiv343/worklogger.git",
    "directory": "packages/setup"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "bitbucket",
    "ai-agents",
    "codex",
    "claude",
    "developer-tools",
    "time-tracking",
    "worklog",
    "pull-requests"
  ]
}
